# Application Settings
APP_NAME=code2guide-agent
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Target Workspace Path (Default scanned codebase)
TARGET_WORKSPACE_PATH=./sample_workspace

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
DEFAULT_MODEL=openrouter/free

# Legacy OpenAI / Anthropic (optional fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google AI Studio embeddings
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Qdrant (Docker: http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_LOCATION=
RIPGREP_PATH=rg
