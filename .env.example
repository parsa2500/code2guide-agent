# Application Settings
APP_NAME=code2guide-agent
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Target Workspace Path (Default scanned codebase)
TARGET_WORKSPACE_PATH=./sample_workspace

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
DEFAULT_MODEL=openrouter/free

# Legacy OpenAI / Anthropic (optional fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google AI Studio embeddings
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Qdrant (Docker: http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_LOCATION=
RIPGREP_PATH=rg

# Knowledge graph (SQLite) + ask-time AST fallback
INDEX_STORAGE_PATH=.code2guide/index
AST_INSPECT_LIMIT=0

# Code-KB / my-kb Hub (W1-04 /ask-mykb spike — no local index on that path)
CODE_KB_BASE_URL=http://127.0.0.1:5051
# Must match DEV_AUTH_TOKEN in my-kb apps/api/.env (do not commit real token)
CODE_KB_TOKEN=

# W3-01 signed auth context (shared by Contracts.Main signer and this API verifier)
AUTH_CONTEXT_SECRET=
