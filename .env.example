# Application Settings
APP_NAME=code2guide-agent
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# LLM API Settings (optional for model routing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o

# Search & Vector Settings
QDRANT_LOCATION=:memory:
EMBEDDING_MODEL=BAAI/bge-m3
RIPGREP_PATH=rg

# Target Workspace Path (Default scanned codebase)
TARGET_WORKSPACE_PATH=./sample_workspace
